#pragma kernel CSMain

uint3 Dims;

RWStructuredBuffer<float> Voxels;

[numthreads(8,8,8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= Dims)) return;

    uint index = id.x + Dims.x * (id.y + Dims.y * id.z);

    float3 pos=float3(id)+0.5f;
    float3 center=float3(Dims)*0.5f;
    float3 halfSize=float3(Dims)*0.35f;
    float3 localPos=abs(pos-center);
    bool inside=localPos.x<halfSize.x&&
        localPos.y<halfSize.y&&
        localPos.z<halfSize.z;

    Voxels[index] = inside?1.0f:-1.0f;
}
